# 复制本文件为 .env 并填入真实值（.env 已在 .gitignore 中，绝不提交！）

# DeepSeek（生成模型，https://platform.deepseek.com 注册充值，几块钱够用很久）
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 硅基流动（Embedding + Rerank，https://siliconflow.cn 注册，有免费额度）
SILICONFLOW_API_KEY=sk-xxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 切分参数（W5 做对比实验时调整）
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索参数
VECTOR_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_K=5

# 数据库（开发期可先用 sqlite:///./data/dev.db，W4 再切 MySQL）
DATABASE_URL=sqlite:///./data/dev.db

# 存储路径
DATA_DIR=data
CHROMA_DIR=data/chroma

# 对话记忆轮数
HISTORY_TURNS=5

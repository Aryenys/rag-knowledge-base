# ⚠️ 最重要：API Key 泄露会被扫号盗用，.env 绝不提交
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# 数据（上传的文档、向量库、sqlite 都不进仓库）
data/

# 日志（W6）：本地运行产生，进仓库只会污染提交记录
logs/

# 前端构建产物以外的依赖
node_modules/

# IDE
.idea/
.vscode/

# 本地学习与求职文档（面试题合集、简历草稿、生成的 Word）
# 这类文件含个人隐私与面试策略，属于「本地资料」而非「项目代码」，不进公开仓库
docs/

# Word 生成流水线的临时构建目录（中间产物，不进仓库）
.docx_build/
